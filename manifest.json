{
  "manifest_version": 3,
  "name": "Mute YouTube Ads",
  "version": "1.1.0",
  "description": "Mute player ads and click the available Skip control.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "106"
}
